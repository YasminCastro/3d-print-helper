generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Printer {
  id                     Int      @id @default(autoincrement())
  name                   String
  model                  String?
  brand                  String?
  powerConsumptionW      Float?   @map("power_consumption_w")
  maintenanceCostPerHour Float?   @map("maintenance_cost_per_hour")
  purchasePrice          Float?   @map("purchase_price")
  lifespanHours          Int?     @map("lifespan_hours")
  energyCostPerKwh       Float?   @map("energy_cost_per_kwh")
  createdAt              DateTime @default(now()) @map("created_at")

  @@map("printers")
}

model FilamentBrand {
  id            Int      @id @default(autoincrement())
  name          String
  whereToBuy    String?  @map("where_to_buy")
  avgPriceMin   Float?   @map("avg_price_min")
  avgPriceMax   Float?   @map("avg_price_max")
  filamentTypes String?  @map("filament_types")
  bestColors    String?  @map("best_colors")
  purchased     Int?     @default(0)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("filament_brands")
}
