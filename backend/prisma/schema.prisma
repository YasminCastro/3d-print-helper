generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  printers Printer[]

  @@map("users")
}

model Printer {
  id                     Int      @id @default(autoincrement())
  name                   String
  model                  String?
  brand                  String?
  powerConsumptionW      Float?   @map("power_consumption_w")
  maintenanceCostPerHour Float?   @map("maintenance_cost_per_hour")
  purchasePrice          Float?   @map("purchase_price")
  lifespanHours          Int?     @map("lifespan_hours")
  energyCostPerKwh       Float?   @map("energy_cost_per_kwh")
  createdAt              DateTime @default(now()) @map("created_at")
  userId                 String   @map("user_id")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("printers")
}

model FilamentBrand {
  id            Int      @id @default(autoincrement())
  name          String
  whereToBuy    String?  @map("where_to_buy")
  avgPriceMin   Float?   @map("avg_price_min")
  avgPriceMax   Float?   @map("avg_price_max")
  filamentTypes String?  @map("filament_types")
  bestColors    String?  @map("best_colors")
  purchased     Int?     @default(0)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  filaments Filament[]

  @@map("filament_brands")
}

model Filament {
  id               Int      @id @default(autoincrement())
  name             String
  availability     String?
  lastPurchaseDate String?  @map("last_purchase_date")
  material         String?
  brandId          Int?     @map("brand_id")
  brand            FilamentBrand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  purchaseLink     String?  @map("purchase_link")
  saleName         String?  @map("sale_name")
  minPricePaid     Float?   @map("min_price_paid")
  maxPricePaid     Float?   @map("max_price_paid")
  nozzleTempMin    Int?     @map("nozzle_temp_min")
  nozzleTempMax    Int?     @map("nozzle_temp_max")
  bedTempMin       Int?     @map("bed_temp_min")
  bedTempMax       Int?     @map("bed_temp_max")
  purchaseBatch    String?  @map("purchase_batch")
  rating           Int?
  color            String?
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("filaments")
}
