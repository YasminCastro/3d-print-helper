{
  "name": "default",
  "version": "1.0.0",
  "description": "default template",
  "scripts": {
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "dev": "cross-env NODE_ENV=development nodemon",
    "dev:watch": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "lint": "biome lint .",
    "check": "biome check .",
    "format": "biome format . --write",
    "start:tsup": "node -r tsconfig-paths/register dist/server.js",
    "build:tsup": "tsup --config tsup.config.ts",
    "test": "jest --config jest.config.cjs --watch",
    "test:e2e": "jest --config jest.config.cjs --testPathPatterns=e2e --watch",
    "test:unit": "jest --config jest.config.cjs --testPathPatterns=unit --watch",
    "deploy:prod": "pm2 start ecosystem.config.js --only backend",
    "deploy:dev": "pm2 start ecosystem.config.js --only dev",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "pg": "^8.22.0",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1",
    "pino-roll": "^3.1.0",
    "pm2": "^7.0.3",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.8.1",
    "tsyringe": "^4.10.0",
    "zod": "^4.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.4",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/hpp": "^0.2.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.0.0",
    "jest": "^30.0.5",
    "node-gyp": "^11.4.2",
    "nodemon": "^3.1.10",
    "prisma": "^7.9.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
